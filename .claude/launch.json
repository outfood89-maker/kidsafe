{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "venv/bin/uvicorn",
      "runtimeArgs": ["main:app", "--reload", "--host", "127.0.0.1", "--port", "3000"],
      "cwd": "server",
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "client",
      "port": 5173
    }
  ]
}
