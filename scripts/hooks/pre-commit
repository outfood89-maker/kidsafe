#!/bin/sh
#
# Kiddy pre-commit 훅 — GD-S0 (2026-08-05 신설)
#
# 왜 있나:
#   오늘까지 검사를 돌리는 건 "팀장이 기억해서"였다. 실제로 성능 회귀 2건은
#   테스트가 있어서 잡혔고, 테스트가 없는 곳(가짜 주입 3건·SPA 404)은 아무도 못 잡았다.
#   → 규칙(약속)을 장치(강제)로 바꾼다. 잊어도 상관없게.
#
# 설계 원칙:
#   1) 빠를 것 — 느리면 --no-verify 로 우회하게 되고 그러면 무용지물이다.
#      바뀐 영역만 검사한다. 문서만 고쳤으면 즉시 통과.
#   2) 무엇이 왜 막혔는지 + 어떻게 고치는지를 반드시 알려줄 것.
#   3) 긴급 우회로를 열어둘 것 — git commit --no-verify
#
# 설치(기기당 1회):  git config core.hooksPath scripts/hooks
#

set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$STAGED" ] && exit 0

FRONT=$(echo "$STAGED" | grep -E '^client/(src|package\.json|vite\.config|vercel\.json)' || true)
BACK=$(echo "$STAGED"  | grep -E '^server/.*\.py$' || true)

fail() {
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "🚫 커밋이 막혔습니다 — $1"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "  $2"
  echo ""
  echo "  ⚠️ 정말 급하면 우회할 수 있습니다:  git commit --no-verify"
  echo "     (단, 오너 커밋 게이트 규칙상 검증 안 된 코드의 푸시는 금지)"
  echo ""
  exit 1
}

# ──────────────────────────────────────────────────────────────
# 🧭 하네스 무결성 — CLAUDE.md 는 **문서지만 검사한다** (2026-08-11 신설)
#
# 🔴 왜 문서인데 막나 — 하네스는 매 세션 통째로 로드되는 **유일한 보호막**이고,
#    거기 거짓이 적히면 **없는 보호를 있다고 믿게 된다**(하네스 본문이 직접 못박은 문장).
#    실제로 2026-08-11 에 두 가지가 동시에 일어났다:
#      · 규칙을 추가하다 **200줄 한도를 어겼다**(204줄). 내가 손으로 세어서 알았다 — 다음엔 안 셀 수 있다.
#      · 규칙 표에 파일명을 적는데, 그 파일이 지워지거나 이름이 바뀌면 **아무도 모른다.**
#
# ⚠️ 이 검사는 위의 '문서만 고쳤으면 통과' **앞**에 있어야 한다 — CLAUDE.md 도 문서다.
# ──────────────────────────────────────────────────────────────
if echo "$STAGED" | grep -qE '^(CLAUDE\.md|\.claude/)'; then
  # ① 200줄 한도 (길수록 지시 준수율이 떨어진다 — 하네스 1행이 직접 경고)
  LINES=$(wc -l < CLAUDE.md | tr -d ' ')
  if [ "$LINES" -gt 200 ]; then
    fail "하네스가 $LINES 줄입니다 (한도 200)" \
      "CLAUDE.md 1행: '200줄을 넘기지 말 것 — 길수록 지시 준수율이 떨어진다'.
     새 규칙은 .claude/rules/ 로 옮기고 하네스에는 **트리거 한 줄**만 남기세요."
  fi

  # ② 하네스가 언급하는 **모든 .md** 가 실재하는가 (없는 보호를 있다고 믿게 되는 자리)
  #    🔴 전체 경로만 보면 안 된다 — 규칙 표는 `backend.md` 처럼 **파일명만** 쓴다.
  #       (첫 구현이 경로만 봤다가 차단 시험 ②가 통과해버려 발견 — 2026-08-11)
  #    ⇒ 루트 기준 또는 .claude/rules/ 아래, 둘 중 하나로 풀리면 통과.
  MISSING=""
  MDS=$(grep -oE '`[^`]+\.md`' CLAUDE.md | tr -d '`' | sort -u)
  MD_N=$(echo "$MDS" | grep -c . || true)
  # 🔴 대조군 — 하나도 못 찾았으면 파서가 헛돈 것이다("0건이라 통과"를 막는다)
  [ "$MD_N" -ge 5 ] || fail "하네스에서 .md 참조를 $MD_N 개밖에 못 찾았습니다" \
    "파서가 헛돌고 있습니다 — 검사가 아무것도 안 하는 상태입니다(지뢰 #13)."
  for f in $MDS; do
    [ -f "$f" ] || [ -f ".claude/rules/$f" ] || MISSING="$MISSING $f"
  done
  if [ -n "$MISSING" ]; then
    fail "하네스가 없는 파일을 가리킵니다:$MISSING" \
      "'하네스에 거짓이 적혀 있는 것이 규칙이 없는 것보다 나쁘다' — 경로를 고치거나 그 줄을 지우세요."
  fi

  # ③ 반대 방향 — 있는데 하네스가 모르는 규칙 파일 (아무도 안 여는 파일이 된다)
  ORPHAN=""
  for f in .claude/rules/*.md; do
    [ -f "$f" ] || continue
    grep -qF "$(basename "$f")" CLAUDE.md || ORPHAN="$ORPHAN $(basename "$f")"
  done
  if [ -n "$ORPHAN" ]; then
    fail "하네스가 모르는 규칙 파일이 있습니다:$ORPHAN" \
      "규칙은 '자동 로드되지 않는다' — 하네스 표에 없으면 **아무도 열지 않는 파일**입니다.
     '📍 상세 규칙은 어디에 있나' 표에 한 줄 추가하세요."
  fi
  echo "   ✅ 하네스 무결성 — ${LINES}/200줄 · 참조한 .md ${MD_N}개 전부 실재 · 고아 규칙 0건"
fi

if [ -z "$FRONT" ] && [ -z "$BACK" ]; then
  echo "✅ pre-commit: 코드 변경 없음(문서·설정만) — 검사 건너뜀"
  exit 0
fi

# ──────────────────────────────────────────────────────────────
# 백엔드 — 서버가 뜨는가 + 🔴 인증 기준선이 풀리지 않았는가
# ──────────────────────────────────────────────────────────────
if [ -n "$BACK" ]; then
  echo "🔍 pre-commit: 백엔드 검사..."
  [ -x server/venv/bin/python ] || fail "server/venv 를 찾을 수 없음" \
    "가상환경이 없습니다. 백엔드 검사를 건너뛰려면 --no-verify 를 쓰세요."

  # 검사 4종을 한 진입점으로: 서버 임포트 + 인증 기준선 + 인가(소유권) + 🐤 윤리선 카나리아
  # 같은 검사를 손으로 보려면:  cd server && ./venv/bin/python _verify_all.py
  OUT=$(cd server && ./venv/bin/python _verify_all.py 2>&1) || {
    echo "$OUT" | grep -E "❌|🔴|🚫|Error|Traceback" | head -14
    fail "백엔드 검사 실패" \
"위 항목을 고치세요. 전체 출력:
       cd server && ./venv/bin/python _verify_all.py

     · 인증 기준선  — 새 라우트에 Depends(get_current_user|require_admin) 를 붙였나
     · 인가(소유권) — 프로필을 다루면 get_owned_profile 또는 user_id 매칭이 있나
     · 🐤 윤리선    — 아이의 비공유 이야기가 부모 화면으로 새지 않나
                     (키디는 아이의 '비밀 친구'. 이 선은 기능이 아니라 존재 이유다)"
  }
  echo "$OUT" | grep -E "^  ✅" | sed 's/^/  /'
fi

# ──────────────────────────────────────────────────────────────
# 프론트 — 테스트 + 빌드
# ──────────────────────────────────────────────────────────────
if [ -n "$FRONT" ]; then
  echo "🔍 pre-commit: 프론트 검사..."
  [ -d client/node_modules ] || fail "client/node_modules 없음" \
    "npm install 을 먼저 실행하세요."

  # ── 배럴 import 차단 (2026-08-07 장치화) ─────────────────────────────
  # 아이콘 2개 쓰려고 `from "react-icons/fa"` 를 적으면 **1,611개가 통째로** 딸려온다.
  # 2026-08-05 실사고: 테스트 import 9.45s → 120.04s, 37개 타임아웃. 동작은 멀쩡해서 안 걸린다.
  # ⚠️ 기존 17곳은 '유산'으로 인정하고 건드리지 않는다(전면 차단하면 그 파일을 만질 때마다 커밋이 막힌다).
  #    → **새로 추가되는 줄(+)만** 본다. 늘어나는 것만 막으면 총량은 줄어들 수밖에 없다.
  NEW_BARREL=$(git diff --cached -U0 -- client/src \
    | grep -E '^\+[^+]' \
    | grep -E 'from +"react-icons/[a-z]+"' || true)
  if [ -n "$NEW_BARREL" ]; then
    echo "$NEW_BARREL" | sed 's/^/     /'
    fail "배럴 import 추가 감지 (react-icons)" \
"위 줄이 아이콘 **1,611개**를 통째로 불러옵니다. 동작은 멀쩡하지만 앱과 테스트가 무거워집니다.
     (2026-08-05 실사고: 테스트 import 9.45s → 120.04s · 37개 타임아웃)

     대신 **인라인 SVG 로 직접 그리세요.** 선례: ProtectedRoute·AdminRoute 둘 다 react-icons 를 쓰지 않습니다.
     상세: .claude/rules/frontend.md 「성능 회귀」"
  fi

  # 1차: 병렬(빠름). vitest 는 워커를 코어 수만큼 띄운다.
  (cd client && npx vitest run >/tmp/kd_vitest.log 2>&1) || {
    # ⚠️ 무더기 'Test timed out' 은 코드가 깨진 게 아니라 **머신이 바빠 워커가 굶은 것**일 수 있다.
    #    2026-08-06 실측: 병렬 31개 실패(import 183초) → 순차 214개 전부 통과(import 7.6초).
    #    거짓 실패를 그냥 두면 훅을 못 믿게 되고 --no-verify 가 습관이 된다 → 순차로 한 번 더 갈라본다.
    # ⚠️ 부하 신호는 한 가지가 아니다. 실측된 두 종류(2026-08-06):
    #    · 워커는 떴는데 5초 안에 못 끝냄     → "Test timed out"
    #    · 워커를 아예 못 띄움(더 바쁠 때)     → "Failed to start ... worker" / "Timeout waiting for worker"
    #    처음엔 앞의 것만 보다가 뒤의 것에 걸려 커밋이 막혔다 — 조건이 좁으면 장치가 무용지물이 된다.
    if grep -qE "Test timed out|Failed to start .*worker|Timeout waiting for worker" /tmp/kd_vitest.log; then
      echo "   ⏳ 타임아웃 감지 — 머신 부하일 수 있어 순차 실행으로 재확인합니다(느립니다)..."
      (cd client && npx vitest run --no-file-parallelism >/tmp/kd_vitest.log 2>&1) || {
        tail -25 /tmp/kd_vitest.log
        fail "프론트 테스트 실패 (순차 재시도에서도 실패)" \
"순차로도 실패했으므로 머신 부하가 아니라 **진짜 실패**입니다. 전체 로그: /tmp/kd_vitest.log"
      }
      echo "   ℹ️  병렬에서는 실패했지만 순차에서 전부 통과 — 코드가 아니라 머신 부하였습니다."
    else
      tail -25 /tmp/kd_vitest.log
      fail "프론트 테스트 실패" \
"위 실패 내용을 보세요. 전체 로그: /tmp/kd_vitest.log
     (타임아웃이 아닌 실패라 로직 문제입니다 — CLAUDE.md 「검증 고정 축 4개」 참조)"
    fi
  }
  PASS=$(grep -Eo 'Tests +[0-9]+ passed' /tmp/kd_vitest.log | tail -1)
  echo "   ✅ ${PASS:-테스트 통과}"

  (cd client && npm run build >/tmp/kd_build.log 2>&1) || {
    tail -20 /tmp/kd_build.log
    fail "프론트 빌드 실패" "위 오류를 고치세요. 전체 로그: /tmp/kd_build.log"
  }
  echo "   ✅ 빌드 성공"
fi

echo "✅ pre-commit 통과"
exit 0
