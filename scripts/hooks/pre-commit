#!/bin/sh
#
# Kiddy pre-commit 훅 — GD-S0 (2026-08-05 신설)
#
# 왜 있나:
#   오늘까지 검사를 돌리는 건 "팀장이 기억해서"였다. 실제로 성능 회귀 2건은
#   테스트가 있어서 잡혔고, 테스트가 없는 곳(가짜 주입 3건·SPA 404)은 아무도 못 잡았다.
#   → 규칙(약속)을 장치(강제)로 바꾼다. 잊어도 상관없게.
#
# 설계 원칙:
#   1) 빠를 것 — 느리면 --no-verify 로 우회하게 되고 그러면 무용지물이다.
#      바뀐 영역만 검사한다. 문서만 고쳤으면 즉시 통과.
#   2) 무엇이 왜 막혔는지 + 어떻게 고치는지를 반드시 알려줄 것.
#   3) 긴급 우회로를 열어둘 것 — git commit --no-verify
#
# 설치(기기당 1회):  git config core.hooksPath scripts/hooks
#

set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$STAGED" ] && exit 0

FRONT=$(echo "$STAGED" | grep -E '^client/(src|package\.json|vite\.config|vercel\.json)' || true)
BACK=$(echo "$STAGED"  | grep -E '^server/.*\.py$' || true)

if [ -z "$FRONT" ] && [ -z "$BACK" ]; then
  echo "✅ pre-commit: 코드 변경 없음(문서·설정만) — 검사 건너뜀"
  exit 0
fi

fail() {
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "🚫 커밋이 막혔습니다 — $1"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "  $2"
  echo ""
  echo "  ⚠️ 정말 급하면 우회할 수 있습니다:  git commit --no-verify"
  echo "     (단, 오너 커밋 게이트 규칙상 검증 안 된 코드의 푸시는 금지)"
  echo ""
  exit 1
}

# ──────────────────────────────────────────────────────────────
# 백엔드 — 서버가 뜨는가 + 🔴 인증 기준선이 풀리지 않았는가
# ──────────────────────────────────────────────────────────────
if [ -n "$BACK" ]; then
  echo "🔍 pre-commit: 백엔드 검사..."
  [ -x server/venv/bin/python ] || fail "server/venv 를 찾을 수 없음" \
    "가상환경이 없습니다. 백엔드 검사를 건너뛰려면 --no-verify 를 쓰세요."

  OUT=$(cd server && ./venv/bin/python -c "
import sys
sys.path.insert(0, '.')
try:
    from main import app
except Exception as e:
    print('IMPORT_FAIL', type(e).__name__, e); sys.exit(2)

noauth = []
for r in app.routes:
    if not hasattr(r, 'dependant'): continue
    deps = [d.call.__name__ for d in r.dependant.dependencies if getattr(d, 'call', None)]
    for m in (r.methods or []):
        if m in ('GET','POST','PUT','DELETE','PATCH') and not deps:
            noauth.append(f'{m} {r.path}')
print('NOAUTH', len(noauth), '|', ', '.join(sorted(noauth)))
" 2>&1) || { echo "$OUT"; fail "서버가 임포트되지 않습니다" "문법 오류·순환 import·모듈 누락을 확인하세요. 위 메시지를 보세요."; }

  case "$OUT" in
    IMPORT_FAIL*) echo "$OUT"; fail "서버가 임포트되지 않습니다" "위 오류를 고치세요." ;;
  esac

  COUNT=$(echo "$OUT" | awk '/^NOAUTH/{print $2}')
  LIST=$(echo "$OUT" | sed 's/^NOAUTH [0-9]* | //')

  # 🔴 인증 기준선: 미인증은 GET / (Railway 헬스체크) 하나뿐이어야 한다 — GD-S0 판정표 §2
  if [ "$COUNT" != "1" ] || [ "$LIST" != "GET /" ]; then
    fail "인증이 없는 엔드포인트가 늘었습니다 (미인증 ${COUNT}개)" \
"현재 미인증: ${LIST}
     허용: GET / 하나뿐 (Railway 헬스체크 — 잠그면 배포가 깨짐)

     새 엔드포인트에는 권한 등급을 붙이세요:
       👤 회원   user: dict = Depends(get_current_user)
       🔑 관리자  admin: dict = Depends(require_admin)
     공개로 두어야 한다면 사유를 GD-S0 판정표 §2 에 기록하고 이 훅을 갱신하세요."
  fi
  echo "   ✅ 서버 임포트 정상 · 미인증 1개(GET /) 유지"
fi

# ──────────────────────────────────────────────────────────────
# 프론트 — 테스트 + 빌드
# ──────────────────────────────────────────────────────────────
if [ -n "$FRONT" ]; then
  echo "🔍 pre-commit: 프론트 검사..."
  [ -d client/node_modules ] || fail "client/node_modules 없음" \
    "npm install 을 먼저 실행하세요."

  (cd client && npx vitest run >/tmp/kd_vitest.log 2>&1) || {
    tail -25 /tmp/kd_vitest.log
    fail "프론트 테스트 실패" \
"위 실패 내용을 보세요. 전체 로그: /tmp/kd_vitest.log
     ⚠️ 전부 'Test timed out' 이면 로직이 아니라 '무거워진 것'일 수 있습니다
        (CLAUDE.md 「성능 회귀」·「디버깅」 절 참조)."
  }
  PASS=$(grep -Eo 'Tests +[0-9]+ passed' /tmp/kd_vitest.log | tail -1)
  echo "   ✅ ${PASS:-테스트 통과}"

  (cd client && npm run build >/tmp/kd_build.log 2>&1) || {
    tail -20 /tmp/kd_build.log
    fail "프론트 빌드 실패" "위 오류를 고치세요. 전체 로그: /tmp/kd_build.log"
  }
  echo "   ✅ 빌드 성공"
fi

echo "✅ pre-commit 통과"
exit 0
