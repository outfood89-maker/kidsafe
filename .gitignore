node_modules
.env
server/venv/
server/__pycache__/
server/routers/__pycache__/
**/__pycache__/
*.pyc

# Express 서버 백업본 (로컬 보관용, 버전 관리 제외)
server_backup/

# 감사 로그 (런타임 기록 — 관리자 이메일 포함, 버전 관리 제외)
server/data/audit-log.json

# 데이터 자동 백업 찌꺼기 (타임스탬프 백업본 — 버전 관리 제외)
server/data/*.backup-*.json
# 키디 로딩 영상 — 런타임은 투명 webp만 커밋. mp4(마젠타 원본/teal/구 압축본)는 대용량이라 제외
client/public/videos/*.mp4

# AD-5/AD-8 PoC 산출물·낙서 표본 (로컬 전용)
scratch/

# 테스트 산출물(이미지 생성 등 로컬 실측 결과·낙서 표본 — 버전 관리 제외)
_test_out/

# Claude Code — 머신별 개인 설정만 제외한다 (2026-08-07 수정)
#   원래는 `.claude/` 를 통째로 무시했다. 2026-07-08 당시엔 그 안에 로컬 설정밖에 없어서
#   맞는 분류였지만, 그 뒤 `.claude/rules/`(작업 규칙 — 팀·다른 기기와 공유돼야 함)가 생기며 전제가 바뀌었다.
#   ⚠️ 폴더를 통째로 막으면 **새로 만드는 것이 기본적으로 사라진다.** 그때마다 이 파일을 고칠 것을
#      기억해야 하는데, 그건 '규칙'이지 '장치'가 아니다 → 기본값을 '공유'로 뒤집는다.
#   개인 것의 표시는 파일명의 `.local.` 이다 (settings.local.json 엔 이 맥의 경로가 6곳 들어있다).
.claude/settings.local.json
.claude/*.local.*

# .env 백업본 — 키가 들어있으므로 절대 커밋 금지
.env.backup*
server/.env.backup*
**/.env.backup*
# 🔴 2026-08-12 — 위 세 줄은 `.env.backup*` **한 가지 이름**만 막았다.
#    내가 `.env.before_clova_restore_...` 라는 이름으로 백업을 만들자 **그대로 추적 대상이 됐다.**
#    키가 든 파일을 막는 규칙이 '이름을 맞춰야만' 동작하면, 다음에 다른 이름을 쓰는 순간 샌다.
#    ⇒ `.env` 로 **시작하는 것은 전부** 막고, 예시 파일만 명시적으로 되살린다.
.env*
**/.env*
!.env.example
!**/.env.example
